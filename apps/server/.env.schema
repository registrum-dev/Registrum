# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @type=enum(development, production, test)
NODE_ENV=development

# @type=port
PORT=3000

# Where the SQLite database and the cover thumbnails are kept. A relative path
# is read from the working directory, which in development is apps/server or
# packages/db -- both two levels below the repository.
DATA_DIR=../../data

# The folder the book folders are mounted under. Shelves are folders inside it.
BOOKS_DIR=../../books

# @type=string(startsWith=file:)
DATABASE_URL=file:${DATA_DIR}/registrum.db

# The password browsers sign in with. Left empty, the shelf is open to anyone
# who can reach the port.
# @optional @sensitive
REGISTRUM_PASSWORD=

# Another origin allowed to call the API, for a web front-end served elsewhere.
# @optional @type=url
CORS_ORIGIN=

# The built web app to serve. Left empty, only the API is served.
# @optional
WEB_DIST=
