# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Where the API server listens in development. The dev server passes `/trpc`
# and `/api` through to it, so the page and the API share an origin the way
# they do when the server hands out the built app.
# @public @type=url
VITE_SERVER_URL=http://localhost:3000
