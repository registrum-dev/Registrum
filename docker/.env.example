# Copy to .env in this folder: cp .env.example .env

# Sign-in password. Leave empty to serve without sign-in.
REGISTRUM_PASSWORD=

# AI features, optional: any OpenAI-compatible endpoint, without /chat/completions.
# Leave AI_BASE_URL and AI_MODEL empty to turn them off.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# compose.tailscale.yaml only.
# An auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# The node's name on the tailnet: https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=registrum
